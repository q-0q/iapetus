MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 23471467}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7d20f73aabcb4cfbaac49363662be3e1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  currentDialogueIndex: 0
  textStartOffset: 0
  dialogues:
  - texts:
    - ...
    - I would not have believed it possible.
    - You carry a divine spark within you. The mountain bends to your will.
    - ...
    - 'There is a passage ahead, through the valley. It has remained sealed for many
      lifetimes. '
    - One of your ilk may be able to open it. If so... there is yet hope for my land...
    advanceDialogueIndex: 1
  - texts:
    - Do you feel the blizzard changing? It weighs heavier with each passing moment.
    - A turning of the age is upon us.
    advanceDialogueIndex: 1
  - texts:
    - The area ahead is dangerous. Keep your wits about you.
    advanceDialogueIndex: 0
  DialogueName: Savaphe
  LookAtOverride: {fileID: 370110605}
  CameraY: 0.35
