--- !u!114 &2057481846
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2057481843}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7d20f73aabcb4cfbaac49363662be3e1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  currentDialogueIndex: 0
  textStartOffset: 0
  dialogues:
  - texts:
    - The purple bits are delicious, soloso!
    - I lap them up wherever I go.
    - Say... you look quick and nimble. Unlike myself.
    - If you find fresh purple bits deeper in the cave, won't you bring them to me?
    - Id be happy to give you something in return.
    advanceDialogueIndex: 1
  - texts:
    - My stalks sensed something emanating deep within this cave. Something powerful
      is here.
    - Whatever it is, I have no mind for it, soloso!
    - Purple bits are my only care!
    advanceDialogueIndex: 1
  - texts:
    - I will be waiting here for you to serve me purple bits.
    - Is 100 purple bits so much to ask?
    advanceDialogueIndex: 0
  DialogueName: Indritzi
  LookAtOverride: {fileID: 671547992}
