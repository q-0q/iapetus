  m_Script: {fileID: 11500000, guid: 7d20f73aabcb4cfbaac49363662be3e1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueController
  currentDialogueIndex: 0
  textStartOffset: 0
  dialogues:
  - texts:
    - Peep! Hey runner!
    - You can carry that <color=#fc206d>surge of energy</color> as long as you don't
      stop or turn too hard!
    - ...how do I know this?
    - Feathered creatures know all the mountain's ins-and-outs. Don'cha know?
    advanceDialogueIndex: 1
  - texts:
    - I'm just passing through this craggy place. I'm on my way to the summit!
    - It's beautiful up there. Peep. Too bad you have no wings!
    advanceDialogueIndex: 1
  - texts:
    - As long as you turn wide and don't stop, you can <color=#fc206d>surge</color>
      as far as you want!
    advanceDialogueIndex: 0
  - texts:
    - Wow, you got up there no problem. Land becomes air, peep!
    advanceDialogueIndex: 0
  DialogueName: Peril
  LookAtOverride: {fileID: 0}
  CameraY: 0.5
