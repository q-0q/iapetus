  dialogues:
  - texts:
    - Ohh-ohng... heheh.
    - I am the Mystagogue. I speak on behalf of the spirits, and pass their judgement.
    - You...
    - Are not worthy. Heheh. The spirits have told me so!
    advanceDialogueIndex: 1
    canvasDelayOffset: 0
  - texts:
    - You are not worthy. The spirits will not change their mind!
    - Only those that face dark trials can earn their favor. Heheh!
    - Ohh-ohhng!
    advanceDialogueIndex: 0
    canvasDelayOffset: 0
  DialogueName: Far Mystagogue
